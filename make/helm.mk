# Helm packaging for the hardware discovery service (task 009).
#
# Pipeline (development.md "Helm contract shared by runtime and packaging"):
#   source config -> make manifests generate build-installer
#                 -> make helm-chart [IMG=...]
#                 -> chart inventory/values review (helm-review-chart)
#                 -> helm-lint / helm-render / helm-package / module-lint
#
# build-installer stays Kustomize-only; the Kubebuilder helm plugin runs it
# itself when regenerating the chart, so this file never wraps one around
# the other. Everything except the explicit lifecycle targets below is
# cluster-free: no target here contacts a cluster unless it is one of
# helm-deploy/helm-status/helm-history/helm-rollback/helm-uninstall, and
# those demand an explicit kubeconfig and context.

# Canonical tools, pinned `go run module@version` (task-001 contract):
# Kubebuilder v4.16.0 helm/v2-alpha plugin and the Helm v4.3.1 CLI.
KUBEBUILDER_VERSION ?= v4.16.0
KUBEBUILDER = $(GO_CMD) run sigs.k8s.io/kubebuilder/v4@$(KUBEBUILDER_VERSION)
HELM_VERSION ?= v4.3.1
HELM = $(GO_CMD) run helm.sh/helm/v4/cmd/helm@$(HELM_VERSION)

# Release identity. The chart pins fullnameOverride, so rendered object
# names are independent of the release name; HELM_RELEASE only labels
# the release and defaults to the module identity used by module-lint.
HELM_RELEASE ?= hardware-discovery
HELM_NAMESPACE ?= opendatahub-hardware-discovery-operator-system
HELM_CHART_DIR ?= dist/chart
HELM_TIMEOUT ?= 5m

# Controller image overrides are whole values: repository and tag are
# passed separately and never split from a combined reference. A digest
# reference belongs in the repository (the chart then suppresses the tag).
CONTROLLER_IMAGE_REPOSITORY ?=
CONTROLLER_IMAGE_TAG ?=

# odh-platform-tools provides `module lint`. The pinned version is the
# commit backing pseudo-version v0.0.0-20261028215308-948ecd9b3ace; the
# module zip cannot build it (its CRD bases are gitignored upstream and
# go:embed'ed), so the pinned local checkout is the execution vehicle
# and its HEAD is verified against the pin before every run.
ODH_PLATFORM_TOOLS_COMMIT ?= 948ecd9b3acec53cdee868bca8d54e4aff74eabd
ODH_PLATFORM_TOOLS_DIR ?= $(HOME)/work/dev/rhai/odh-platform-tools
ODH_PLATFORM_TOOLS_WORK ?= dist/module-tool

# Chart identity, parsed from the preserved Chart.yaml.
CHART_NAME := $(shell sed -n 's/^name: *//p' $(HELM_CHART_DIR)/Chart.yaml 2>/dev/null)
CHART_VERSION := $(shell sed -n 's/^version: *//p' $(HELM_CHART_DIR)/Chart.yaml 2>/dev/null)
HELM_PACKAGE_ARCHIVE ?= dist/$(CHART_NAME)-$(CHART_VERSION).tgz

##@ Helm packaging (cluster-free)

.PHONY: helm-chart
helm-chart: ## Regenerate dist/chart from source config via the pinned Kubebuilder helm plugin, then curate it.
	$(KUBEBUILDER) edit --plugins=helm/v2-alpha
	$(MAKE) helm-curate-chart

.PHONY: helm-curate-chart
helm-curate-chart: ## Align freshly generated chart templates with the packaging contract.
	@if grep -qE '^  image:' $(HELM_CHART_DIR)/values.yaml; then \
		if git ls-files --error-unmatch $(HELM_CHART_DIR)/values.yaml >/dev/null 2>&1; then \
			echo "NOTE: $(HELM_CHART_DIR)/values.yaml was regenerated by the plugin (the curated file was missing);" >&2; \
			echo "      restoring the committed curated values from git." >&2; \
			git checkout -- $(HELM_CHART_DIR)/values.yaml; \
		else \
			echo "ERROR: $(HELM_CHART_DIR)/values.yaml was regenerated by the plugin (the curated file was missing)" >&2; \
			echo "       and no committed curated version exists to restore." >&2; \
			echo "       Commit the curated values.yaml first (see docs/development.md, Packaging)." >&2; \
			exit 1; \
		fi \
	fi
	@# The plugin generates the image under manager.image.{repository,tag} and the
	@# container command as [/manager] with the operator subcommand in manager.args.
	@# The approved contract keeps image values under the top-level
	@# controllerImage.{repository,tag} (whole values, see test/support/helm)
	@# and the canonical command [/manager, operator]; the curated values.yaml
	@# carries --leader-elect only in manager.args and no operator entry.
	@# The deletion keeps the command rewrite idempotent on an already
	@# curated template (operator belongs to the command, never to args).
	sed -i \
		-e 's/\.Values\.manager\.image\./\.Values.controllerImage./g' \
		-e '/^        - operator$$/d' \
		-e 's|^        - /manager$$|        - /manager\n        - operator|' \
		$(HELM_CHART_DIR)/templates/manager/manager.yaml
	@# The plugin re-scaffolds an unpinned CI workflow on every run; this
	@# PoC ships no release/CI matrix (development.md, Helm contract), so
	@# the curated state carries no .github/workflows/test-chart.yml.
	rm -f .github/workflows/test-chart.yml
	rmdir .github/workflows .github 2>/dev/null || true

.PHONY: helm-review-chart
helm-review-chart: helm-chart ## Regenerate the chart and verify it matches the committed reviewed state.
	@status=$$(git status --porcelain -- $(HELM_CHART_DIR)); if [ -n "$$status" ]; then \
		echo "ERROR: $(HELM_CHART_DIR) differs from the committed reviewed chart:" >&2; \
		echo "$$status" >&2; \
		echo "       Review the diff (git diff -- $(HELM_CHART_DIR)), then commit it." >&2; \
		exit 1; \
	fi
	@echo "Reviewed chart inventory:"
	@find $(HELM_CHART_DIR) -type f | sort

.PHONY: helm-lint
helm-lint: ## Lint the chart with the pinned Helm CLI.
	$(HELM) lint $(HELM_CHART_DIR)

.PHONY: helm-render
helm-render: ## Render the chart with default values into dist/rendered.yaml.
	mkdir -p dist
	$(HELM) template $(HELM_RELEASE) $(HELM_CHART_DIR) \
		--namespace $(HELM_NAMESPACE) > dist/rendered.yaml
	@echo "Rendered chart written to dist/rendered.yaml"

.PHONY: helm-package
helm-package: ## Package the chart into dist/ and verify the archive inventory and usability.
	$(HELM) package $(HELM_CHART_DIR) -d dist/
	@set -e; \
	archive=$(HELM_PACKAGE_ARCHIVE); \
	test -f "$$archive" || { echo "ERROR: expected archive $$archive not found" >&2; exit 1; }; \
	if tar -tzf "$$archive" | grep -Eq '(\.context|\.git/|\.kube|kubeconfig|\.env|id_rsa|\.pem|install\.yaml|rendered\.yaml)'; then \
		echo "ERROR: archive $$archive contains scratch, key or build artifacts:" >&2; \
		tar -tzf "$$archive" | grep -E '(\.context|\.git/|\.kube|kubeconfig|\.env|id_rsa|\.pem|install\.yaml|rendered\.yaml)' >&2; \
		exit 1; \
	fi; \
	tar -tzf "$$archive" | grep -Eq "^[^/]*/Chart.yaml$$" || { echo "ERROR: archive has no Chart.yaml" >&2; exit 1; }; \
	tar -tzf "$$archive" | grep -Eq "^[^/]*/values.yaml$$" || { echo "ERROR: archive has no values.yaml" >&2; exit 1; }; \
	echo "Archive inventory:"; tar -tzf "$$archive" | sort
	@# The archive must stay usable standalone: lint and render it directly.
	$(HELM) lint $(HELM_PACKAGE_ARCHIVE)
	$(HELM) template $(HELM_RELEASE) $(HELM_PACKAGE_ARCHIVE) \
		--namespace $(HELM_NAMESPACE) > dist/rendered-from-archive.yaml
	@echo "Archive linted and rendered standalone (dist/rendered-from-archive.yaml)"

.PHONY: module-lint
module-lint: helm-chart ## Lint packaging/module.yaml against the chart with the pinned odh-platform-tools (offline).
	@test -d $(ODH_PLATFORM_TOOLS_DIR) || { \
		echo "ERROR: odh-platform-tools checkout not found at $(ODH_PLATFORM_TOOLS_DIR)" >&2; \
		echo "       (override with ODH_PLATFORM_TOOLS_DIR=<path>)" >&2; \
		exit 1; }
	@actual=$$(git -C $(ODH_PLATFORM_TOOLS_DIR) rev-parse HEAD 2>/dev/null); \
	test "$$actual" = "$(ODH_PLATFORM_TOOLS_COMMIT)" || { \
		echo "ERROR: odh-platform-tools at $(ODH_PLATFORM_TOOLS_DIR) is $$actual" >&2; \
		echo "       expected the pinned commit $(ODH_PLATFORM_TOOLS_COMMIT)" >&2; \
		exit 1; }
	@# Extract the pinned commit (not the working tree) and build the tool
	@# there: its CRD bases are gitignored upstream, so the binary can only
	@# be built from a checkout after generating them.
	rm -rf $(ODH_PLATFORM_TOOLS_WORK) && mkdir -p $(ODH_PLATFORM_TOOLS_WORK)
	git -C $(ODH_PLATFORM_TOOLS_DIR) archive $(ODH_PLATFORM_TOOLS_COMMIT) | tar -x -C $(ODH_PLATFORM_TOOLS_WORK)
	cd $(ODH_PLATFORM_TOOLS_WORK) && $(MAKE) manifests
	cd $(ODH_PLATFORM_TOOLS_WORK) && $(GO_CMD) run ./cmd module lint --config $(CURDIR)/packaging/module.yaml

##@ Helm lifecycle (require an explicit kubeconfig and context)

# Read-only lifecycle targets need the exact kubeconfig/context so they
# can never touch an ambient cluster. Mutating targets additionally
# require an explicit chart-review acknowledgment (HELM_CHART_REVIEWED=yes)
# after `make helm-review-chart`.

.PHONY: helm-deploy
helm-deploy: ## Install/upgrade the release (mutates a cluster). Requires KUBECONFIG, HELM_KUBECONTEXT, HELM_CHART_REVIEWED=yes and whole controllerImage values.
ifndef KUBECONFIG
	$(error KUBECONFIG must name the target cluster's kubeconfig file explicitly)
endif
ifndef HELM_KUBECONTEXT
	$(error HELM_KUBECONTEXT must name the exact kube context to mutate)
endif
ifneq ($(HELM_CHART_REVIEWED),yes)
	$(error helm-deploy mutates a cluster: run `make helm-review-chart`, inspect the chart, then retry with HELM_CHART_REVIEWED=yes)
endif
ifeq ($(CONTROLLER_IMAGE_REPOSITORY),)
	$(error CONTROLLER_IMAGE_REPOSITORY must be set (whole value; digest references go here, never the tag))
endif
ifeq ($(CONTROLLER_IMAGE_TAG),)
	$(error CONTROLLER_IMAGE_TAG must be set (whole value; use the chart/app version))
endif
	$(HELM) upgrade --install $(HELM_RELEASE) $(HELM_CHART_DIR) \
		--namespace $(HELM_NAMESPACE) \
		--create-namespace \
		--kubeconfig $(KUBECONFIG) \
		--kube-context $(HELM_KUBECONTEXT) \
		--set controllerImage.repository=$(CONTROLLER_IMAGE_REPOSITORY) \
		--set controllerImage.tag=$(CONTROLLER_IMAGE_TAG) \
		--wait \
		--timeout $(HELM_TIMEOUT)

.PHONY: helm-status
helm-status: ## Show release status (read-only). Requires KUBECONFIG and HELM_KUBECONTEXT.
ifndef KUBECONFIG
	$(error KUBECONFIG must name the target cluster's kubeconfig file explicitly)
endif
ifndef HELM_KUBECONTEXT
	$(error HELM_KUBECONTEXT must name the exact kube context to use)
endif
	$(HELM) status $(HELM_RELEASE) --namespace $(HELM_NAMESPACE) \
		--kubeconfig $(KUBECONFIG) --kube-context $(HELM_KUBECONTEXT)

.PHONY: helm-history
helm-history: ## Show release history (read-only). Requires KUBECONFIG and HELM_KUBECONTEXT.
ifndef KUBECONFIG
	$(error KUBECONFIG must name the target cluster's kubeconfig file explicitly)
endif
ifndef HELM_KUBECONTEXT
	$(error HELM_KUBECONTEXT must name the exact kube context to use)
endif
	$(HELM) history $(HELM_RELEASE) --namespace $(HELM_NAMESPACE) \
		--kubeconfig $(KUBECONFIG) --kube-context $(HELM_KUBECONTEXT)

.PHONY: helm-rollback
helm-rollback: ## Roll back the release (mutates a cluster). Requires KUBECONFIG, HELM_KUBECONTEXT and HELM_CHART_REVIEWED=yes.
ifndef KUBECONFIG
	$(error KUBECONFIG must name the target cluster's kubeconfig file explicitly)
endif
ifndef HELM_KUBECONTEXT
	$(error HELM_KUBECONTEXT must name the exact kube context to mutate)
endif
ifneq ($(HELM_CHART_REVIEWED),yes)
	$(error helm-rollback mutates a cluster: run `make helm-review-chart`, inspect the chart, then retry with HELM_CHART_REVIEWED=yes)
endif
	$(HELM) rollback $(HELM_RELEASE) --namespace $(HELM_NAMESPACE) \
		--kubeconfig $(KUBECONFIG) --kube-context $(HELM_KUBECONTEXT) \
		--wait --timeout $(HELM_TIMEOUT)

.PHONY: helm-uninstall
helm-uninstall: ## Uninstall the release, retaining the CRDs (mutates a cluster). Requires KUBECONFIG, HELM_KUBECONTEXT and HELM_CHART_REVIEWED=yes.
ifndef KUBECONFIG
	$(error KUBECONFIG must name the target cluster's kubeconfig file explicitly)
endif
ifndef HELM_KUBECONTEXT
	$(error HELM_KUBECONTEXT must name the exact kube context to mutate)
endif
ifneq ($(HELM_CHART_REVIEWED),yes)
	$(error helm-uninstall mutates a cluster: run `make helm-review-chart`, inspect the chart, then retry with HELM_CHART_REVIEWED=yes)
endif
	$(HELM) uninstall $(HELM_RELEASE) --namespace $(HELM_NAMESPACE) \
		--kubeconfig $(KUBECONFIG) --kube-context $(HELM_KUBECONTEXT) \
		--wait --timeout $(HELM_TIMEOUT)
