# Build artifacts
bin/
vendor/
*.test
cover.out
covmeta*
covcounters*
# dist/ holds build outputs (install.yaml, chart archives, rendered
# manifests) except the chart itself: dist/chart is generated by
# `make helm-chart` but its templates and preserved metadata are
# reviewed and committed like source.
dist/*
!dist/chart/
Dockerfile.cross

# Go workspace file
go.work
go.work.sum

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# Kubeconfig (local dev)
.kube/
*.kubeconfig

# IDE
.vscode/
.idea/
.cursor/

# OS
.DS_Store
*~
*.swp
*.swo

# Generated (controller-gen)
config/crd/bases/
config/rbac/role.yaml

# Generated (kustomize edit)
config/manager/kustomization.yaml

# Generated (helm chart)
config/chart/

# OpenCode
.opencode/

# Devcontainer
.devcontainer/

# Custom golangci-lint plugin config
.custom-gcl.yml

# Makefile overrides
local.mk
*.mktmp.*
.context/
